{
  "name": "argand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "format": "prettier --write src tests package.json tsconfig.json vite.config.ts index.html ../README.md",
    "format:check": "prettier --check src tests package.json tsconfig.json vite.config.ts index.html ../README.md",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "katex": "0.18.2",
    "lucide-react": "^0.468.0",
    "mathlive": "0.111.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
